# --- choose ONE provider (default: anthropic) ---
LLM_PROVIDER=anthropic      # anthropic | groq | openrouter | cerebras | nvidia | ollama | custom
# LLM_MODEL=                # optional: override the provider's default model id
# LLM_TEMPERATURE=0         # open models tool-call more reliably at 0

ANTHROPIC_API_KEY=sk-ant-...

# Free / open-weight providers (only the one you use is needed)
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
# Ollama needs no key (http://localhost:11434/v1). Run: ollama pull qwen2.5:7b

# Any other OpenAI-compatible server (vLLM, llama.cpp, LM Studio...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=

AGENT_MODEL=claude-sonnet-5-5   # default model when provider=anthropic
AGENT_MAX_STEPS=12
AGENT_MAX_TOTAL_TOKENS=60000
